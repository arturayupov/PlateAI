# ---- Google Gemini (required) ----
# Get a key at https://aistudio.google.com/apikey (enable billing for image models).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Public URL of the deployed app (used for Stripe success/cancel redirects).
APP_URL="http://localhost:3000"

# ---- Stripe (required only for the hosted paywall; not needed when self-hosting) ----
# Secret key from the Stripe Dashboard (Developers > API keys).
STRIPE_SECRET_KEY=""
# Price ID for the one-time $19 menu-download unlock.
STRIPE_PRICE_ID=""

# ---- Paywall config ----
# Secret used to sign download entitlement tokens. Use a long random string in production.
ENTITLEMENT_SECRET=""
# How many free AI photo generations each visitor (per IP) gets before unlocking.
FREE_GENERATION_LIMIT=6

# Port (Cloud Run / most hosts inject this automatically).
# PORT=3000
